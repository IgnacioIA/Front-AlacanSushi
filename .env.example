# URL base que usa el frontend para llamar a la API (sin barra final).
# En desarrollo es el prefijo del proxy de Vite: el navegador habla solo con
# Vite y Vite reenvía a API_PROXY_TARGET quitando "/api" (ver vite.config.js).
VITE_API_BASE_URL=/api

# Destino del proxy de desarrollo: URL del backend Spring Boot (sin barra
# final). Solo la lee vite.config.js; no tiene prefijo VITE_ y no llega al
# bundle del navegador. El backend corre en el puerto 8080 por defecto.
API_PROXY_TARGET=http://localhost:8080

# Número de WhatsApp del restaurante (formato internacional, sin "+" ni espacios,
# ej. 5491122334455), usado por el frontend público para armar el link
# https://wa.me/<numero>?text=... con el mensaje prearmado del pedido.
# Ningún contrato de la API lo define (WhatsApp es 100% responsabilidad del
# frontend, ver docs/frontend/integration 27-8-2026/V1-SCOPE.md §4.6) — completar
# con el número real del restaurante antes de pasar a producción.
VITE_WHATSAPP_NUMBER=5491100000000
